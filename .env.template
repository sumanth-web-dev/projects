# Application Settings
SECRET_KEY=generate_a_secure_random_key_here
ENCRYPTION_KEY=generate_a_secure_encryption_key_here
ADMIN_USER_ID=admin_user_id_here

# Database Settings
POSTGRES_PASSWORD="1234" #secure_database_password_here
DATABASE_URL="postgresql+psycopg2://postgres:1234@localhost:5432/Test"
# AI Service Settings
AI_API_KEY=your_ai_api_key_here

# Deployment Settings
FLASK_APP=app.py
FLASK_ENV=production
INITIALIZE_DB=false
SEED_DB=false

# Logging Settings
LOG_LEVEL=WARNING

# Rate Limiting Settings
REDIS_URL=redis://redis:6379/0

# Monitoring Settings
MONITORING_ENABLED=true
METRICS_INTERVAL=60
METRICS_RETENTION_DAYS=7