# Application Settings
SECRET_KEY=development_secret_key_123456789
ENCRYPTION_KEY=development_encryption_key_123456789
ADMIN_USER_ID=admin

# Database Settings
DATABASE_URL=sqlite:///job_agent.db


# AI Service Settings
AI_API_KEY=dummy_key

# Deployment Settings
FLASK_APP=app.py
FLASK_ENV=development
INITIALIZE_DB=true
SEED_DB=true

# Logging Settings
LOG_LEVEL=INFO

# Rate Limiting Settings
# Using in-memory rate limiting for development

# Monitoring Settings
MONITORING_ENABLED=true
METRICS_INTERVAL=60
METRICS_RETENTION_DAYS=7